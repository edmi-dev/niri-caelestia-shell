// niri config snippet for caelestia-shell (niri >= 26.04). Include it at the END of your niri config:
//     include "caelestia.kdl"
// The home-manager module writes it to ~/.config/niri/caelestia.kdl (programs.caelestia.niri.enable).
//
// niri has no global-shortcuts protocol: every former shell shortcut is an IpcHandler function called with
// `caelestia-shell ipc call <target> <function> [args]`. niri has no key-release binds, so the launcher
// toggles on press.

binds {
    // Drawers (modules/Shortcuts.qml, target "drawers")
    Mod+Space repeat=false { spawn "caelestia-shell" "ipc" "call" "drawers" "toggle" "launcher"; }
    Mod+D repeat=false { spawn "caelestia-shell" "ipc" "call" "drawers" "toggle" "dashboard"; }
    Mod+Escape repeat=false { spawn "caelestia-shell" "ipc" "call" "drawers" "toggle" "session"; }
    Mod+S repeat=false { spawn "caelestia-shell" "ipc" "call" "drawers" "toggle" "sidebar"; }
    Mod+U repeat=false { spawn "caelestia-shell" "ipc" "call" "drawers" "toggle" "utilities"; }
    Mod+A repeat=false { spawn "caelestia-shell" "ipc" "call" "drawers" "showAll"; }
    Mod+I repeat=false { spawn "caelestia-shell" "ipc" "call" "nexus" "open"; }

    // Lock (modules/lock/Lock.qml, target "lock")
    Mod+L allow-when-locked=true { spawn "caelestia-shell" "ipc" "call" "lock" "lock"; }

    // Screenshots (modules/areapicker/AreaPicker.qml, target "picker")
    Print { spawn "caelestia-shell" "ipc" "call" "picker" "open"; }
    Mod+Shift+S { spawn "caelestia-shell" "ipc" "call" "picker" "openFreeze"; }
    Ctrl+Print { spawn "caelestia-shell" "ipc" "call" "picker" "openClip"; }
    Mod+Shift+C { spawn "caelestia-shell" "ipc" "call" "picker" "openFreezeClip"; }

    // Media (services/Players.qml, target "mpris")
    XF86AudioPlay allow-when-locked=true { spawn "caelestia-shell" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev allow-when-locked=true { spawn "caelestia-shell" "ipc" "call" "mpris" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "caelestia-shell" "ipc" "call" "mpris" "next"; }
    XF86AudioStop allow-when-locked=true { spawn "caelestia-shell" "ipc" "call" "mpris" "stop"; }

    // Brightness (services/Brightness.qml, target "brightness"; step size from the shell config)
    XF86MonBrightnessUp allow-when-locked=true { spawn "caelestia-shell" "ipc" "call" "brightness" "increase"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "caelestia-shell" "ipc" "call" "brightness" "decrease"; }

    // Notifications (services/Notifs.qml, target "notifs")
    Mod+Shift+N { spawn "caelestia-shell" "ipc" "call" "notifs" "clear"; }
}

// No blur layer-rule for "caelestia-drawers": that layer covers the whole output, and a rule-enabled blur
// applies to the full surface with xray on by default (niri 26.04 docs/wiki/Window-Effects.md), so every
// non-fullscreen window would be hidden behind blurred wallpaper. Shaped blur needs ext-background-effect
// from the shell itself.

// Game mode overrides written by the shell (Compositor.setGameMode); must stay last to win over the rest.
include optional=true "caelestia-gamemode.kdl"
